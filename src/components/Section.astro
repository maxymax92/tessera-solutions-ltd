---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section class="section wrap" id={id} aria-labelledby={headingId}>
  <h2 id={headingId}>
    <span class="tile" aria-hidden="true"></span>
    {title}
  </h2>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .tile {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 0.09em;
    background: var(--tile);
  }

  @media (min-width: 60rem) {
    .section {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 3rem;
    }

    h2 {
      align-self: start;
      position: sticky;
      top: 2rem;
    }
  }
</style>
