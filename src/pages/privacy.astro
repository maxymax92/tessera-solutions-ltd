---
import Base from "../layouts/Base.astro";
import { company, mailto } from "../site.ts";

const githubPrivacy =
  "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement";
---

<Base
  title="Privacy · Tessera Solutions"
  description="How the Tessera Solutions website handles your data: cookies, analytics, hosting on GitHub Pages and the emails you send."
>
  <article class="wrap page">
    <h1>Privacy</h1>
    <p class="label">Updated 12 November 2026</p>

    <h2>This Site</h2>
    <p>
      This site doesn’t set cookies or run analytics or tracking scripts. Its
      fonts and images are served from this site, so your browser doesn’t
      contact anyone else to show it.
    </p>

    <h2>Hosting</h2>
    <p>
      GitHub Pages hosts this site. GitHub logs the IP address of each visitor
      for security purposes, including visitors without a GitHub account. GitHub
      handles that data under the{" "}
      <a href={githubPrivacy}>GitHub General Privacy Statement</a>.
    </p>

    <h2>Email</h2>
    <p>
      If you email us, we receive your email address, your name if your email
      includes it, and what you write. Our email provider stores them for us. We
      use them to reply to you and to keep a record of the conversation, and we
      keep them only as long as that record is needed. We don’t share them with
      anyone or use them for marketing.
    </p>

    <h2>Your Rights</h2>
    <p>
      {company.name} is the controller of personal data you send us. Under UK
      data protection law you can ask to see, correct or delete it. Write to{" "}
      <a href={mailto}>{company.email}</a>. You can also complain to the
      Information Commissioner’s Office at{" "}
      <a href="https://ico.org.uk">ico.org.uk</a>.
    </p>
  </article>
</Base>

<style>
  .page {
    display: grid;
    gap: 1rem;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
  }

  h1 {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    letter-spacing: -0.04em;
  }

  .label {
    margin-bottom: 1.5rem;
  }

  h2 {
    margin-top: 1.5rem;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  p {
    color: var(--muted);
  }
</style>
