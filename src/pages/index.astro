---
import Mosaic from "../components/Mosaic.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";
import { company, mailto } from "../site.ts";

const services = [
  {
    title: "Bespoke Solutions",
    body: [
      "Software designed around how an organisation already runs: its data, its access rules and the people who sign off each step. We take it from discovery and architecture through build, testing and handover.",
    ],
    work: [
      "Product strategy, roadmap and build of a pricing and approval platform for a global professional services firm, with an AI agent that prices through the firm’s own engines, reads only what each person may see, and waits for a person to approve every change.",
    ],
  },
  {
    title: "Programme Management",
    body: [
      "Technical project and programme management for complex, regulated delivery: discovery, solution architecture, roadmaps, supplier and commercial governance, risk, testing and go-live, run as agile, waterfall or a hybrid of both.",
      "Security and resilience are part of the job: SOC 2, ISO 27001 and GDPR controls, penetration testing, data protection impact assessments, business continuity, disaster recovery and operational acceptance testing.",
    ],
    work: [],
  },
  {
    title: "Software Studio",
    body: [
      "We design and build our own products, starting with Flip.",
      "Our engineering uses AI agents inside a written lifecycle: a specification with testable acceptance criteria, tests for each criterion, an independent verification pass, and review before anything merges.",
    ],
    work: [],
  },
];

const approach = [
  {
    term: "Discovery First",
    detail:
      "We learn the problem, the people and the systems already in place, and agree what finished looks like before the build starts.",
  },
  {
    term: "Written Decisions",
    detail:
      "Requirements, architecture and trade-offs go in writing, so your team can pick the work up across time zones and after handover.",
  },
  {
    term: "Security by Design",
    detail:
      "Access control, audit trails and data protection are designed alongside the features they protect.",
  },
  {
    term: "Root Causes",
    detail:
      "A defect gets fixed where it starts. Every change passes type checks, strict linting and a clean build before it merges.",
  },
  {
    term: "Direct Contact",
    detail: "You work with the principal from the first call to handover.",
  },
];

const stages = [
  "Search",
  "Valuation",
  "Viewing",
  "Funding",
  "Purchase",
  "Renovation",
  "Sale",
];

const sectors = [
  {
    term: "Public Sector",
    detail:
      "A real-time integration run as critical national infrastructure: new event-driven APIs across legacy and cloud platforms, built by delivery teams from several suppliers, delivered within budget and ahead of its deadlines.",
  },
  {
    term: "Health",
    detail:
      "Cloud platform, DevOps and data migration teams with over 96% SLA adherence, and a new digital service for reporting infectious disease cases that replaced a paper process.",
  },
  {
    term: "Software Consultancy",
    detail:
      "AWS-native platforms for clients, including the core APIs for a cloud vehicle software update service and product carbon tracking with physical tag hardware.",
  },
  {
    term: "Hospitality",
    detail:
      "Digital transformation across more than 220 venues: ordering apps for iOS and Android, payments, and booking and events platforms.",
  },
];
---

<Base title="Tessera Solutions">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="intro">
      <h1 id="hero-title">Tessera Solutions</h1>
      <p class="lead">
        We build bespoke software, run technical projects and programmes, and
        develop our own products.
      </p>
      <p class="sub">
        Our work draws on over ten years of technology delivery in the public
        sector, health, software consultancy and hospitality.
      </p>
      <div class="actions">
        <a class="button" href={mailto}>
          Email us
        </a>
        <a class="quiet" href="#services">
          Services
        </a>
      </div>
    </div>
    <div class="art">
      <Mosaic />
    </div>
  </section>

  <Section id="services" title="Services">
    <div class="services">
      {services.map((service) => (
        <article class="service">
          <h3>{service.title}</h3>
          {service.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {service.work.length > 0 && (
            <>
              <p class="label">Recent Work</p>
              <ul class="work">
                {service.work.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}
    </div>
  </Section>

  <Section id="approach" title="Approach">
    <dl class="pairs">
      {approach.map((entry) => (
        <div>
          <dt>{entry.term}</dt>
          <dd>{entry.detail}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="flip" title="Flip">
    <div class="flip">
      <p class="label">In Development</p>
      <p class="statement">Flip runs a UK property deal from search to sale.</p>
      <ol class="stages" aria-label="Deal stages">
        {stages.map((stage) => (
          <li>{stage}</li>
        ))}
      </ol>
      <p>
        It covers finding a property, valuing it, viewing it, funding it, buying
        it with a review of the legal pack, renovating it and selling it. Teams
        share deals, tasks and contacts, with settings that decide who sees
        what.
      </p>
      <p>
        Flip runs on iPhone, iPad and Mac from one SwiftUI codebase. Valuations
        follow written rules. Claude on Amazon Bedrock reads legal packs, so
        they stay inside AWS, and Apple’s on-device models handle transcription,
        document sorting and drafts.
      </p>
    </div>
  </Section>

  <Section id="about" title="About">
    <div class="about">
      <p class="statement">
        Tessera Solutions Ltd was incorporated in England and Wales in March
        2026.
      </p>
      <p>
        Its principal has over ten years in technology delivery, most recently
        as a senior technical programme manager, and holds the AWS Certified
        Solutions Architect, APMG Agile Project Management Practitioner and
        Certified Scrum Master credentials.
      </p>
      <dl class="pairs">
        {sectors.map((entry) => (
          <div>
            <dt>{entry.term}</dt>
            <dd>{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section id="contact" title="Contact">
    <div class="contact">
      <a class="address" href={mailto}>
        {company.email}
      </a>
      <p>Tell us about the problem, the timeline and the people involved.</p>
    </div>
  </Section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 9vw, 8rem) clamp(3.5rem, 9vw, 7.5rem);
  }

  h1 {
    font-size: clamp(2.75rem, 1.6rem + 5.6vw, 6.25rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .lead {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 450;
  }

  .sub {
    margin-top: 1.25rem;
    max-width: var(--measure);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .button,
  .quiet {
    display: inline-flex;
    align-items: center;
    min-height: 2.875rem;
    font-weight: 500;
  }

  .button {
    padding-inline: 1.25rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition: background-color 160ms var(--ease);
  }

  .button:hover {
    background: var(--accent);
  }

  .art {
    width: min(100%, 26rem);
    justify-self: end;
  }

  .services {
    display: grid;
    gap: 3rem;
  }

  .service {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: var(--measure);
  }

  h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .service .label {
    margin-top: 0.75rem;
  }

  .work {
    display: grid;
    gap: 0.875rem;
    color: var(--muted);
  }

  .work li {
    position: relative;
    padding-left: 1.25rem;
  }

  .work li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 1px;
    background: var(--line);
  }

  .pairs {
    display: grid;
    gap: 1.75rem;
    max-width: 44rem;
  }

  .pairs div {
    display: grid;
    gap: 0.375rem;
  }

  dt {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  dd {
    color: var(--muted);
  }

  .flip,
  .about,
  .contact {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .statement {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .stages li {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .about .pairs {
    margin-top: 1.25rem;
  }

  .address {
    font-size: clamp(1.25rem, 0.9rem + 2.2vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    text-decoration-color: var(--tile);
    text-decoration-thickness: 2px;
  }

  .contact p {
    color: var(--muted);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }

    .service:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (width < 60rem) {
    .art {
      order: -1;
      width: min(60%, 14rem);
    }
  }
</style>
