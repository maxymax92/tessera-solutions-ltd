---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Missing · Tessera Solutions"
  description="Nothing exists at this address."
  index={false}
>
  <section class="wrap missing" aria-labelledby="missing-title">
    <p class="label">Error 404</p>
    <h1 id="missing-title">Page Missing</h1>
    <p>
      Nothing exists at this address. The home page has everything on this site.
    </p>
    <a class="home" href="/">
      Go to the home page
    </a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  h1 {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    letter-spacing: -0.04em;
  }

  p:not(.label) {
    max-width: var(--measure);
    color: var(--muted);
  }

  .home {
    font-weight: 500;
  }
</style>
