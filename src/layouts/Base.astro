---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { palette } from "../brand/mark.ts";
import { company } from "../site.ts";

interface Props {
  title: string;
  description?: string;
  index?: boolean;
}

const { title, description = company.description, index = true } = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/(?:index)?\.html$/, ""),
  company.url,
).href;
const share = new URL("/og.png", company.url).href;
const organisation = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  url: company.url,
  email: company.email,
  logo: new URL("/brand/tessera-mark.svg", company.url).href,
  vatID: company.vat,
  identifier: {
    "@type": "PropertyValue",
    propertyID: "Companies House company number",
    value: company.number,
  },
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? (
      <link rel="canonical" href={canonical} />
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={palette.paper}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={palette.night}
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tessera: bespoke software, technical delivery and our own products."
    />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={organisation} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
